.about-container {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 1200px;
  margin: 50px auto;
  gap: 40px;
  padding: 20px;
  background-color: rgba(0,0,0,0.6); /* Semi-transparent background */
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.about-image img {
  width: 400px;
  max-width: 100%;
  border-radius: 20px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  transition: transform 0.3s, box-shadow 0.3s;
}

.about-image img:hover {
  transform: scale(1.05);
  box-shadow: 0 12px 30px rgba(0,0,0,0.5);
}

.about-text {
  flex: 1;
  color: #f5f5f5;
}

.about-text p {
  font-size: 1.1em;
  margin-bottom: 20px;
  line-height: 1.6;
}

.about-text .highlight {
  color: gold;
  font-weight: 600;
}

/* Responsive for mobile */
@media (max-width: 768px) {
  .about-container {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }

  .about-image img {
    width: 80%;
  }

  .about-text p {
    font-size: 1em;
  }
}
