* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #0b0b0b;
  color: #ffffff;
}

/* NAVBAR */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 80px;
  position: fixed;
  width: 100%;
  top: 0;
  background: rgba(0,0,0,0.8);
  backdrop-filter: blur(8px);
  z-index: 1000;
}

.logo {
  font-weight: 600;
  font-size: 1.1rem;
}

.navbar nav a {
  margin-left: 30px;
  text-decoration: none;
  color: #aaa;
  font-size: 0.95rem;
  transition: color 0.3s;
}

.navbar nav a:hover,
.navbar nav a.active {
  color: #f5c77a;
}

/* HERO SECTION */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 120px 80px 60px;
}

/* LEFT */
.hero-text {
  flex: 1;
}

.intro {
  font-size: 0.85rem;
  color: #888;
  letter-spacing: 2px;
}

.hero-text h1 {
  font-size: 3.5rem;
  margin: 10px 0;
}

.tagline {
  font-size: 1.2rem;
  color: #ccc;
  margin-bottom: 20px;
}

.roles {
  font-size: 0.85rem;
  letter-spacing: 2px;
  color: #777;
  margin-bottom: 30px;
}

.socials a {
  margin-right: 20px;
  text-decoration: none;
  color: #f5c77a;
  font-size: 0.9rem;
}

/* RIGHT IMAGE */
.hero-image {
  flex: 1;
  display: flex;
  justify-content: center;
}

.hero-image img {
  width: 350px;
  border-radius: 50%;
  box-shadow: 0 0 120px rgba(245, 199, 122, 0.6);
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero {
    flex-direction: column;
    text-align: center;
  }

  .hero-image {
    margin-top: 40px;
  }
}

.fade-enter-active, .fade-leave-active {
  transition: opacity 0.6s ease;
}
.fade-enter-from, .fade-leave-to {
  opacity: 0;
}

<transition name="fade">
  <section id="gallery">...</section>
</transition>

.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
}
.modal img {
  max-width: 90%;
  max-height: 90%;
  border-radius: 15px;
}
